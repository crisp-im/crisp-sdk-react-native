{
  "name": "crisp-sdk-react-native",
  "version": "0.4.4",
  "description": "Expo Module bridge for Crisp Chat iOS and Android SDK",
  "keywords": [
    "crisp",
    "chat",
    "react-native",
    "expo"
  ],
  "author": "Crisp IM SAS",
  "homepage": "https://github.com/crisp-im/crisp-sdk-react-native",
  "license": "MIT",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": [
    "./build/ExpoCrispSdkModule.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisp-im/crisp-sdk-react-native.git"
  },
  "scripts": {
    "build": "expo-module build",
    "build:plugin": "expo-module build plugin",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "expo-module test",
    "prepare": "expo-module prepare",
    "prepublishOnly": "yarn release:check && expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/ios",
    "open:android": "open -a \"Android Studio\" example/android",
    "format": "biome check --write .",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "version": "changeset version",
    "test:release": "node --test scripts/__tests__/*.test.cjs",
    "release:check": "node scripts/check-release.cjs",
    "release:validate": "yarn lint && yarn lint plugin && biome check scripts && yarn test:release && yarn test --runInBand && yarn build && yarn build:plugin",
    "release:prepare": "node scripts/pack-candidate.cjs",
    "release": "yarn release:check && yarn release:prepare && changeset publish"
  },
  "bugs": {
    "url": "https://github.com/crisp-im/crisp-sdk-react-native/issues"
  },
  "packageManager": "yarn@4.7.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "2.29.8",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "8.57.1",
    "expo": "~58.0.26",
    "expo-module-scripts": "5.0.7",
    "jest": "30.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "ts-jest": "29.4.6"
  },
  "peerDependencies": {
    "expo": ">=58.0.0",
    "react": "*",
    "react-native": ">=0.88.0"
  },
  "files": [
    "build",
    "plugin/build",
    "app.plugin.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "docs/API.md",
    "docs/PUSH_NOTIFICATIONS.md",
    "ios/*.swift",
    "ios/*.podspec",
    "ios/Tests/*.swift",
    "android/build.gradle",
    "android/src/main",
    "expo-module.config.json"
  ]
}
